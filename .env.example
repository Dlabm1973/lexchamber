# Server-only configuration. Never include these values in browser assets.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
ALLOWED_EMAILS=

# Optional direct email: Brevo API key (not an SMTP key). Store as a runtime secret.
BREVO_API_KEY=
# Verify accounts@lexchamber.co.za as a sender in Brevo.

# Clerk — use a matching pair; live keys and domain setup are needed for production.
AUTH_PROVIDER=clerk
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY is a Next.js convention; this Worker uses CLERK_PUBLISHABLE_KEY.
